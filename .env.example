# Copy to .env at the repository root. Do not commit .env.
# The connector reads this file on startup. Values already set in the process environment win.

# Learning AI. Used only by the local connector. Never put this in the website or the cloud.
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# Optional. The connector uses openai/gpt-oss-120b when this is omitted.
GROQ_MODEL=openai/gpt-oss-120b

# Existing Prentice settings also live in this file.
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, and SUPABASE_SECRET_KEY are for auth and the cloud process.
# DATABASE_URL is the cloud database. The connector does not use it.
# PRENTICE_CLOUD_URL is the relay the website and connector dial.
# Local default: http://127.0.0.1:4740
# Hosted later: https://your-relay.example.com
# The website build copies that URL to NEXT_PUBLIC_PRENTICE_CLOUD_URL. Do not set a Groq variable there.
# Do not prefix GROQ_API_KEY with NEXT_PUBLIC_.
#
# Relay process, when you deploy it:
# PRENTICE_CLOUD_HOST=0.0.0.0
# PORT is provided by the host. PRENTICE_CLOUD_PORT=4740 is the local default.
# PRENTICE_WEB_ORIGINS=https://your-site.example.com
#
# Connector process, when you point it at that relay:
# PRENTICE_CLOUD_URL=https://your-relay.example.com
# GROQ_API_KEY stays on the connector only.
# Leave PRENTICE_DEV_HTTP unset unless you also want the local HTTP adapter.
#
# Website host, when you deploy it:
# SUPABASE_URL
# SUPABASE_PUBLISHABLE_KEY
# PRENTICE_CLOUD_URL
# Add the website origin to the Supabase redirect allow-list.
# Do not put SUPABASE_SECRET_KEY, DATABASE_URL, or GROQ_API_KEY on the website.
