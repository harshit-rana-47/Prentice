# Copy to .env at the repository root. Do not commit .env.
# The connector reads this file on startup. Values already set in the process environment win.

# Learning AI. Used only by the Prentice cloud. Never put this in the website or the connector.
GROQ_API_KEY=
# Optional. The cloud uses openai/gpt-oss-120b when this is omitted.
GROQ_MODEL=openai/gpt-oss-120b
# Independent examiner on the same provider. Must differ from GROQ_MODEL.
GROQ_REVIEW_MODEL=qwen/qwen3.8-27b
# Setting this to disabled retains the conservative legacy tutor; semantic mastery is unavailable.

# Supabase project configuration. Required for sign-in and the cloud.
# Use a dedicated development project, never production credentials for tests.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Public addresses. These loopback defaults are for local development only.
PRENTICE_CLOUD_URL=http://127.0.0.1:4740
PRENTICE_WEBSITE_URL=http://127.0.0.1:3000

# Remote database connections always verify the certificate chain and hostname.
# For a Supabase endpoint requiring its project CA, download the CA from the
# project's Database Settings over HTTPS and mount it on the cloud host:
# PRENTICE_DATABASE_CA_FILE=/path/to/supabase-ca.crt
# Alternatively, DATABASE_URL may specify sslrootcert=/path/to/supabase-ca.crt.
# With neither configured (or sslrootcert=system), Node's trusted roots are used.
# Never disable certificate verification to work around a CA or hostname error.
# PRENTICE_CLOUD_URL is the relay the website and connector dial.
# Local default: http://127.0.0.1:4740
# Hosted later: https://your-relay.example.com
# The website build copies that URL to NEXT_PUBLIC_PRENTICE_CLOUD_URL. Do not set a Groq variable there.
# Do not prefix GROQ_API_KEY with NEXT_PUBLIC_.
#
# Relay process, when you deploy it:
# PRENTICE_CLOUD_HOST=0.0.0.0
# PORT is provided by the host. PRENTICE_CLOUD_PORT=4740 is the local default.
# PRENTICE_WEB_ORIGINS=https://your-site.example.com
#
# Connector process on the computer, for the hosted site (`npm run connect`):
# PRENTICE_CLOUD_URL=https://your-relay.example.com
# PRENTICE_WEBSITE_URL=https://your-site.example.com
# GROQ_API_KEY stays on the cloud only. The connector sends an evidence summary and does not receive the key.
# Leave PRENTICE_DEV_HTTP unset. The connect script does not set it, and it does not run the fixture provider.
# npm run package:mac and npm run package:win copy PRENTICE_CLOUD_URL and PRENTICE_WEBSITE_URL into the desktop apps. They do not copy secrets.
#
# Local development: npm run dev creates PRENTICE_DEV_LEARNING_TOKEN for each run. Never set it on a hosted cloud;
# the cloud ignores it unless it is bound to 127.0.0.1.
#
# Release packaging (npm run package:mac -- --release): PRENTICE_CLOUD_URL and PRENTICE_WEBSITE_URL must be public https.
# PRENTICE_MAC_SIGN_IDENTITY="Developer ID Application: ..."  and  PRENTICE_MAC_NOTARY_PROFILE=<notarytool profile>
#
# Website host, when you deploy it:
# PRENTICE_DOWNLOAD_BASE_URL=https://downloads.your-site.example.com/  (hosts Prentice-Mac.zip and Prentice-Windows.msi)
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# NEXT_PUBLIC_PRENTICE_CLOUD_URL
# These are build-time variables. Local next.config.ts also maps root .env values.
# Add the website origin to the Supabase redirect allow-list.
# Do not put SUPABASE_SECRET_KEY, DATABASE_URL, or GROQ_API_KEY on the website.

# Set only after building/signing and validating MSI installation on Windows.
# PRENTICE_WINDOWS_MSI_READY=1
# Windows release signing uses a provisioned certificate store, never pasted private keys.
# PRENTICE_WIN_CERT_SHA1=your-certificate-thumbprint
# PRENTICE_WIN_TIMESTAMP_URL=https://your-rfc3161-timestamp-endpoint.example.com
